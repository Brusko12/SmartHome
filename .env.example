# Copy to .env in the repository root. These defaults are optional.
SMARTHOME_PORT=8000
SMARTHOME_LOG_LEVEL=info
# Absolute persistent data directory; do not use a PyInstaller extraction folder.
# Windows default: %LOCALAPPDATA%\SmartHome\data
# SMARTHOME_DATA_DIR=C:\Users\YourName\AppData\Local\SmartHome\data
# Linux default: $XDG_DATA_HOME/SmartHome/data or ~/.local/share/SmartHome/data
